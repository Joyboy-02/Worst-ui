# ==============================================================================
# "WORST UI" AGRICULTURE CROP ADVISORY ASSISTANT - CONFIGURATION
# ==============================================================================

# Supabase Configuration (Leave empty or set your credentials)
# If empty, the app runs in built-in Zero-Config In-Memory Mock Mode with real RLS emulation!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google GenAI Configuration
# Server-side official @google/genai SDK integration
# If left empty, the server automatically provides high-fidelity existential dread agronomic responses
GEMINI_API_KEY=your-gemini-api-key

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

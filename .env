# Supabase Configuration
# When using Supabase, enter your URL and keys.
# Otherwise, the server automatically provides built-in in-memory session persistence.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google GenAI Configuration
# The server uses the official @google/genai SDK with model 'gemini-2.5-flash'.
# If you provide your key, real Gemini responses will be generated.
# If left blank, the built-in Existential Dread Agronomist engine delivers authentic sarcastic advice.
GEMINI_API_KEY=

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
